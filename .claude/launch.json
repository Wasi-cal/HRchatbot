{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "source .venv/bin/activate && PORT=8001 ./run_api.sh"
      ],
      "port": 8001
    },
    {
      "name": "web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd web && API_URL=http://localhost:8001 npx next dev -p 3001"
      ],
      "port": 3001
    }
  ]
}