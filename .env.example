# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real credentials.

# --- Postgres connection (vector store) ---
# Hostname of the Postgres instance. Use "localhost" when running the
# bundled docker-compose.yml on this machine.
PGHOST=localhost
# Port Postgres is listening on. The bundled docker-compose.yml maps the
# container's 5432 to 5434 on the host, to avoid colliding with other
# local Postgres instances.
PGPORT=5434
# Database name to connect to.
PGDATABASE=hrchatbot
# Postgres role used by the application.
PGUSER=hrchatbot
# Password for PGUSER. Required - there is no default in code.
PGPASSWORD=changeme

# --- Connection pool sizing (vectorstore/db.py) ---
# Minimum number of persistent connections the pool keeps open.
PG_POOL_MIN=1
# Maximum number of connections the pool will open under load.
PG_POOL_MAX=5

# --- Embedding model ---
# Hugging Face model id used for embedding generation (dense + sparse).
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# Free-form version label recorded in embedding_models.version - bump this
# if you change tokenization/normalization settings for the same model id.
EMBEDDING_MODEL_VERSION=v1

# --- Ingestion output ---
# Folder containing the ingestion pipeline's per-document chunk JSON files
# (see main.py) - this is what the load script reads.
INGESTION_OUTPUT_DIR=out_chunks

# --- Generation layer (generation/generate.py) ---
# Required - OpenAI API key used for the generation call. Never hardcode
# this; get one from https://platform.openai.com/api-keys.
OPENAI_API_KEY=sk-changeme
# Chat model used for answer generation, registered into provider_configs
# on first run if no active generation config exists yet. Optional -
# defaults to a lightweight model (see generation/generate.py) if unset.
GENERATION_MODEL_NAME=gpt-4o-mini
# Minimum top fused_score (from vectorstore/retrieve.py) required to
# attempt generation at all; below this, generation is skipped entirely
# and a canned "I don't have that information" response is returned.
# See generation/generate.py's module docstring for how this default was
# chosen. Optional - falls back to the code default if unset.
GENERATION_CONFIDENCE_THRESHOLD=0.02
